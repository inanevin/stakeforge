set(Stakeforge_VERSION "@VERSION@")
set(Stakeforge_BUILD_ID "@BUILD_ID@")
set(Stakeforge_CONFIGURATION "@CONFIGURATION@")
set(Stakeforge_COMPILER_VERSION "@COMPILER_VERSION@")
set(Stakeforge_WINDOWS_SDK "@WINDOWS_SDK@")

if(NOT WIN32 OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "@COMPILER_ID@")
    message(FATAL_ERROR "This Stakeforge SDK requires Windows and @COMPILER_ID@.")
endif()
if(NOT CMAKE_SIZEOF_VOID_P EQUAL @POINTER_SIZE@ OR
   NOT CMAKE_CXX_COMPILER_ARCHITECTURE_ID STREQUAL "@ARCHITECTURE@")
    message(FATAL_ERROR "This Stakeforge SDK requires the @ARCHITECTURE@ architecture.")
endif()
if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS Stakeforge_COMPILER_VERSION)
    message(FATAL_ERROR "This Stakeforge SDK requires MSVC @COMPILER_VERSION@ or newer.")
endif()
if(CMAKE_VS_PLATFORM_TOOLSET AND NOT CMAKE_VS_PLATFORM_TOOLSET STREQUAL "@TOOLSET@")
    message(FATAL_ERROR "This Stakeforge SDK requires the @TOOLSET@ platform toolset.")
endif()

if(CMAKE_CONFIGURATION_TYPES)
    set(CMAKE_CONFIGURATION_TYPES "${Stakeforge_CONFIGURATION};Packaged" CACHE STRING "Game configurations" FORCE)
elseif(CMAKE_BUILD_TYPE AND NOT CMAKE_BUILD_TYPE STREQUAL Stakeforge_CONFIGURATION AND NOT CMAKE_BUILD_TYPE STREQUAL "Packaged")
    message(FATAL_ERROR "This Stakeforge SDK supports ${Stakeforge_CONFIGURATION} and Packaged game configurations.")
elseif(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE "${Stakeforge_CONFIGURATION}" CACHE STRING "SDK configuration" FORCE)
endif()

set(CMAKE_MSVC_RUNTIME_LIBRARY "@MSVC_RUNTIME@")
set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT ProgramDatabase)
set(CMAKE_CXX_FLAGS [==[@CXX_FLAGS@]==])
set(CMAKE_CXX_FLAGS_@CONFIGURATION_UPPER@ [==[@CXX_CONFIG_FLAGS@]==])
set(CMAKE_CXX_FLAGS_PACKAGED [==[@CXX_CONFIG_FLAGS@]==])
set(CMAKE_SHARED_LINKER_FLAGS [==[@SHARED_LINKER_FLAGS@]==])
set(CMAKE_SHARED_LINKER_FLAGS_@CONFIGURATION_UPPER@ [==[@SHARED_LINKER_CONFIG_FLAGS@]==])
set(CMAKE_SHARED_LINKER_FLAGS_PACKAGED [==[@SHARED_LINKER_CONFIG_FLAGS@]==])
set(CMAKE_EXE_LINKER_FLAGS [==[@EXE_LINKER_FLAGS@]==])
set(CMAKE_EXE_LINKER_FLAGS_@CONFIGURATION_UPPER@ [==[@EXE_LINKER_CONFIG_FLAGS@]==])
set(CMAKE_EXE_LINKER_FLAGS_PACKAGED [==[@EXE_LINKER_CONFIG_FLAGS@]==])

foreach(_stakeforge_output IN ITEMS RUNTIME ARCHIVE LIBRARY PDB)
    if(CMAKE_${_stakeforge_output}_OUTPUT_DIRECTORY)
        set(CMAKE_${_stakeforge_output}_OUTPUT_DIRECTORY_PACKAGED
            "${CMAKE_${_stakeforge_output}_OUTPUT_DIRECTORY}/Packaged/${Stakeforge_CONFIGURATION}")
    endif()
endforeach()

unset(_stakeforge_output)
get_filename_component(_stakeforge_sdk_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

if(NOT TARGET Stakeforge::core)
    add_library(Stakeforge::core SHARED IMPORTED)
    set_target_properties(Stakeforge::core PROPERTIES
        IMPORTED_LOCATION "${_stakeforge_sdk_root}/../../stakeforge_core.dll"
        IMPORTED_IMPLIB "${_stakeforge_sdk_root}/lib/@CORE_LIBRARY@"
        INTERFACE_COMPILE_FEATURES cxx_std_23
        INTERFACE_INCLUDE_DIRECTORIES "@INCLUDE_DIRECTORIES@"
        INTERFACE_COMPILE_DEFINITIONS "@DEFINITIONS@"
        INTERFACE_COMPILE_OPTIONS "@OPTIONS@;/Zi;$<IF:$<CONFIG:Packaged>,/O2,/Od>;$<IF:$<CONFIG:Packaged>,/Ob2,/Ob0>"
        INTERFACE_LINK_OPTIONS "/PDBALTPATH:$<TARGET_PDB_FILE_NAME:$<TARGET_PROPERTY:NAME>>;/DEBUG;/INCREMENTAL:NO;$<IF:$<CONFIG:Packaged>,/OPT:REF,/OPT:NOREF>;$<IF:$<CONFIG:Packaged>,/OPT:ICF,/OPT:NOICF>"
        INTERFACE_LINK_LIBRARIES "@LIBRARIES@"
    )
endif()

if(NOT TARGET Stakeforge::tools)
    add_library(Stakeforge::tools SHARED IMPORTED)
    set_target_properties(Stakeforge::tools PROPERTIES
        IMPORTED_LOCATION "${_stakeforge_sdk_root}/../../stakeforge_tools.dll"
        IMPORTED_IMPLIB "${_stakeforge_sdk_root}/lib/@TOOLS_LIBRARY@"
        INTERFACE_COMPILE_DEFINITIONS SFG_TOOLS_SHARED
        INTERFACE_LINK_LIBRARIES Stakeforge::core
    )
endif()

if(CMAKE_GENERATOR MATCHES "^Visual Studio ")
    set_property(GLOBAL PROPERTY USE_FOLDERS ON)

    foreach(_stakeforge_module IN ITEMS core tools)
        if(NOT TARGET stakeforge_${_stakeforge_module})
            file(GLOB_RECURSE _stakeforge_sources CONFIGURE_DEPENDS
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.h"
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.hpp"
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.hxx"
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.inl"
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.ipp"
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.inc"
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.def"
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.c"
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.cc"
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.cpp"
                "${_stakeforge_sdk_root}/include/sfg/${_stakeforge_module}/*.cxx"
            )
            set_source_files_properties(${_stakeforge_sources} PROPERTIES HEADER_FILE_ONLY TRUE)
            add_custom_target(stakeforge_${_stakeforge_module} SOURCES ${_stakeforge_sources})
            source_group(TREE "${_stakeforge_sdk_root}/include" PREFIX src FILES ${_stakeforge_sources})
            set_target_properties(stakeforge_${_stakeforge_module} PROPERTIES FOLDER stakeforge)
        endif()
    endforeach()

    unset(_stakeforge_sources)
    unset(_stakeforge_module)
endif()

unset(_stakeforge_sdk_root)
