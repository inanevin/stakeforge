macro(link_dxc project)
   set(DIRNAME "dxc")
   set(LIBNAME "dxcompiler")
   target_include_directories(${project} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/deps/${DIRNAME}/include)
   target_link_libraries(${project} PUBLIC debug ${CMAKE_CURRENT_SOURCE_DIR}/deps/${DIRNAME}/Win64/Debug/${LIBNAME}.lib optimized  ${CMAKE_CURRENT_SOURCE_DIR}/deps/${DIRNAME}/Win64/Release/${LIBNAME}.lib)
   message("${project} -> ${DIRNAME} has been linked.")
endmacro()